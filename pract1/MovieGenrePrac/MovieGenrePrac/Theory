import Foundation
import SwiftUI

// MARK: - Movie Model
struct Movie: Identifiable {
    let id: UUID
    var title: String
    var genre: Genre
    var rating: Double
    var year: Int
    var synopsis: String
    var duration: Int
    var isWatched: Bool

    init(
        title: String,
        genre: Genre,
        rating: Double,
        year: Int,
        synopsis: String,
        duration: Int,
        isWatched: Bool = false
    ) {
        self.id = UUID()
        self.title = title
        self.genre = genre
        self.rating = rating
        self.year = year
        self.synopsis = synopsis
        self.duration = duration
        self.isWatched = isWatched
    }
}

// MARK: - Genre Enum
enum Genre: String, CaseIterable {
    case action = "Action"
    case drama = "Drama"
    case thriller = "Thriller"
    case scifi = "Sci-Fi"
    case comedy = "Comedy"

    var icon: String {
        switch self {
        case .action: return "flame.fill"
        case .drama: return "theatermasks.fill"
        case .thriller: return "eye.trianglebadge.exclamationmark.fill"
        case .scifi: return "sparkles"
        case .comedy: return "face.smiling.fill"
        }
    }

    var color: Color {
        switch self {
        case .action: return .red
        case .drama: return .purple
        case .thriller: return .orange
        case .scifi: return .blue
        case .comedy: return .yellow
        }
    }
}
```

### 📖 Theory: why are Foundation and SwiftUI imported?

`Foundation` provides common types and functionality, including `UUID`. `SwiftUI` provides UI types such as `Color`.

The genre enum is technically a domain concept, but in this tutorial it also supplies icon names and colours for the interface. This is a deliberate tutorial design that keeps each genre's presentation mapping in one place.

### 📖 Theory: why does Genre conform to CaseIterable?

Later, the form uses:

```swift
Genre.allCases
```

That produces all five cases. The picker can generate its options from the enum, so adding a new genre to the enum also makes it available to the picker.

### 📖 Why Movie has a custom initializer

The initializer guarantees every new movie receives a `UUID`. It also sets `isWatched` to `false` by default, which is the natural starting status for a movie created through the Add Movie form.

The `year` and `duration` names match your tutorial. Keep them consistent across all files.

